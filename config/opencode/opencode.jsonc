{
  "$schema": "https://opencode.ai/config.json",
  "model": "ofox/qwen/qwen3.8-flash",
  "small_model": "ofox/bailian/qwen-flash",
  "agent": {
    "title": {
      "model": "ofox/bailian/qwen-flash",
      "prompt": "Сформируй короткий заголовок сессии — максимум 5-6 слов, по сути задачи, на русском. Верни ТОЛЬКО заголовок, без кавычек, без пояснений, одной строкой."
    },
    "build": {
      "model": "ofox/qwen/qwen3.8-flash",
      "permission": {
        "glob": "allow",
        "external_directory": "allow"
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  },
  "provider": {
    "ofox": {
      "options": {
        "setCacheKey": true
      },
      "models": {
        "qwen/qwen3.8-flash": {
          "name": "Qwen3.8 Flash",
          "attachment": true,
          "reasoning": true,
          "tool_call": true, "temperature": true,
          "modalities": {
            "input": ["text", "image", "video", "pdf"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      }
    }
  },
  "attachment": {
    "image": {
      "max_width": 1600,
      "max_height": 1200,
      "max_base64_bytes": 3000000
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      ".cursor/**": "deny"
    }
  },
  "lsp": {
    "bash": {
      "disabled": true
    },
    "yaml-ls": {
      "disabled": true
    },
    "eslint": {
      "disabled": true
    },
    "oxlint": {
      "disabled": true
    }
  },
  "mcp": {
    "yougile": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@nebelov/yougile-mcp"
      ],
      "environment": {
        "YOUGILE_API_KEY": "<PUT_YOUGILE_API_KEY_HERE>",
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      },
      "enabled": true
    }
  },
  "instructions": [
    "C:/Users/99-ErofeenkoVA/.config/opencode/rules/*.md"
  ]
}
